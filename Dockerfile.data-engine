# syntax=docker/dockerfile:1
# entx-data-engine: EPI data engine worker (collectors + scheduler + /health). Separate from the Next app image.
# Coolify: build pack Dockerfile, file Dockerfile.data-engine, no domain, health check /health on 8080.

FROM oven/bun:1.3-alpine AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production --ignore-scripts

FROM oven/bun:1.3-alpine AS run
WORKDIR /app
ENV NODE_ENV=production ENGINE_HEALTH_PORT=8080
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY data-engine ./data-engine
COPY src/data/catalog.json ./src/data/catalog.json
RUN rm -rf data-engine/fixtures && find data-engine -name '*.test.ts' -delete
USER bun
EXPOSE 8080
# Alpine ships busybox wget, which Coolify's own health check needs.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD wget -qO- http://127.0.0.1:8080/health >/dev/null || exit 1
CMD ["bun", "data-engine/main.ts"]
