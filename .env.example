# NEAR (testnet). Defaults to the shared ENTX hackathon contract if unset.
NEXT_PUBLIC_NEAR_CONTRACT=entx-exchange-52194.testnet
# NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.fastnear.com

# Trusted oracle signer (server-only). Created for you by scripts/near-deploy.sh.
# Without it the app works, but EPI updates are not published on-chain.
NEAR_ORACLE_ACCOUNT=
NEAR_ORACLE_PRIVATE_KEY=

# Solana (devnet)
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# NEAR Intents 1Click (optional JWT; without it the public 0.2% fee tier applies to quotes)
# ONECLICK_JWT=
