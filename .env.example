# NEAR (testnet). Defaults to the shared ENTX hackathon contract if unset.
NEXT_PUBLIC_NEAR_CONTRACT=entx-market-1794654167.testnet
# NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.fastnear.com

# Oracle signer (server-only): function-call key limited to report_epi. Created by scripts/near-deploy.sh.
# Without it the app works, but EPI updates are not published on-chain.
NEAR_ORACLE_ACCOUNT=
NEAR_ORACLE_PRIVATE_KEY=
# true = in-app oracle buttons can publish (demo host only; globally rate-limited). Never true on the live host.
# Otherwise a bearer secret is required.
ENTX_PUBLIC_ORACLE=false
ORACLE_API_SECRET=

# Solana (devnet)
# NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com

# NEAR Intents 1Click (optional JWT; without it the public 0.2% fee tier applies to quotes)
# ONECLICK_JWT=

# Deployment (build-time). See docs/deploy-coolify.md
# NEXT_PUBLIC_ENTX_MODE=demo            # demo | live
# NEXT_PUBLIC_CHAIN=near                # near | solana
# NEXT_PUBLIC_FLAG_CHAIN_SWITCH=false
# TRUST_PROXY=true                      # behind Coolify/Traefik: rate limits use the last X-Forwarded-For hop
